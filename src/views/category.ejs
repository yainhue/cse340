<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= category.name %>
        </h2>
        <h3>Service Projects:</h3>
        <ul>
            <% projects.forEach((project)=> { %>
                <p><a href="/project/<%= project.project_id %>">
                        <strong>
                            <%=project.date.toLocaleDateString('en-US');%>
                        </strong>: <%= project.title %></a><a href="/organization/<%= project.organization_id %>"><em>(
                            <%= project.organization_name %>)
                        </em></a>
                </p>
                <% }); %>
        </ul>

        <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-category/<%= category.category_id %>">Edit Category</a>
            <% } %>

    </main>
    <%- include('partials/footer') %>
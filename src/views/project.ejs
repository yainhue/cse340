<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= project.title %>
        </h2>
        <p>
            <%= project.description %>
        </p>
        <p><strong>Project Date:</strong>
            <em>
                <%= project.date.toLocaleDateString('en-US') %>
            </em>
        </p>
        <p><strong>Location:</strong> <em>
                <%= project.location %>
            </em></p>

        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><em>
                    <%= project.organization_name %>
                </em></a></p>

        <p><strong>Categories:</strong></p>
        <ul>
            <% categories.forEach((category)=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>
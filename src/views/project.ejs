<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= project.title %>
        </h2>
        <p>
            <%= project.description %>
        </p>
        <p><strong>Project Date:</strong>
            <em>
                <%= project.date.toLocaleDateString('en-US') %>
            </em>
        </p>
        <p><strong>Location:</strong> <em>
                <%= project.location %>
            </em></p>
        <a href="/organization/<%= project.organization_id %>">
            <strong>Organization:</strong> <em>
                <%= project.organization_name %>
            </em>
        </a>
    </main>
    <%- include('partials/footer') %>
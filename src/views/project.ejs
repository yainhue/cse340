<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= project.title %>
        </h2>
        <p>
            <%= project.description %>
        </p>
        <p><strong>Project Date:</strong>
            <em>
                <%= project.date.toLocaleDateString('en-US') %>
            </em>
        </p>
        <p><strong>Location:</strong> <em>
                <%= project.location %>
            </em></p>

        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><em>
                    <%= project.organization_name %>
                </em></a></p>

        <p><strong>Categories:</strong></p>
        <ul>
            <% categories.forEach((category)=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            <a href="/assign-categories/<%= project.project_id %>">Assign Categories</a>
            <% } %>
                <% if (user && isVolunteer==false) { %>
                    <form action="/signup/<%= project.project_id %>" method="POST">
                        <button type="submit">Sign Up as Volunteer</button>
                    </form>

                    <% } %>
                        <% if (user && isVolunteer==true) { %>
                            <p>You are already singed up for this project.</p>
                            <form action="/removefrom/<%= project.project_id %>" method="POST">
                                <button type="submit">Remove myself as a volunteer</button>
                            </form>
                            <% } %>

    </main>
    <%- include('partials/footer') %>
<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach((project)=> { %>
                <p><strong>
                        <%=project.project_date.toLocaleDateString('en-US');%>
                    </strong>: <%= project.title %> (<%= project.organization_name %>)
                </p>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>